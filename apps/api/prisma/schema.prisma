generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  SETUP
  HOMOLOGATION
  READY_TO_PUBLISH
  PUBLISHED
  SUSPENDED
  FINISHED
  CANCELLED
}

enum EventProfileCode {
  SCIENTIFIC_EVENT
  CORPORATE_TRAINING
  FAIR_EXHIBITION
  ENTERTAINMENT
  SOCIAL_COMMUNITY
  OTHER
}

enum EventFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum RegistrationMode {
  FREE
  PAID
  INVITATION
}

enum RegistrationProofRequirement {
  NONE
  REQUIRED_BEFORE_PAYMENT
}

enum RegistrationBenefitKind {
  COUPON
  INVITATION
  COURTESY
}

enum RegistrationReservationStatus {
  PENDING_PAYMENT
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum RegistrationCheckoutStatus {
  CREATING
  ACTIVE
  PAID
  PAID_REVIEW
  CANCELED
  EXPIRED
  FAILED
  UNKNOWN
}

enum EventMediaUsage {
  LOGO
  COVER
  SOCIAL_SHARE
}

enum EventMediaAssetState {
  ACTIVE
  REPLACED
  REMOVED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

enum CapabilityStatus {
  ACTIVE
  DISABLED
}

enum PasswordRecoveryAuditOutcome {
  IGNORED
  DELIVERED
  DELIVERY_FAILED
  PERSISTENCE_FAILED
  RATE_LIMITED
  VERIFICATION_COMPLETED
  VERIFICATION_REJECTED
  RESET_COMPLETED
  RESET_REJECTED
}

enum WizardSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ScientificPersonStatus {
  ACTIVE
  INACTIVE
}

enum ScientificTaxonomyLevel {
  AREA
  SUBAREA
  TOPIC
}

enum ScientificParticipationType {
  SPEAKER
  GUEST
  MODERATOR
  DEBATER
  SESSION_CHAIR
  OTHER
}

enum ScientificInvitationStatus {
  DRAFT
  PREPARED
  SENT
  VIEWED
  CONFIRMED
  DECLINED
  CANCELLED
}

enum ScientificProgramSpaceKind {
  ROOM
  AUDITORIUM
  STAGE
  VIRTUAL
  OTHER
}

enum ScientificProgramActivityStatus {
  DRAFT
  READY_FOR_REVIEW
}

enum ScientificSubmissionStatus {
  DRAFT
  INCOMPLETE
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  ACCEPTED_WITH_CHANGES
}

enum ScientificReviewMode {
  OPEN
  SINGLE_BLIND
  DOUBLE_BLIND
}

enum ScientificReviewAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  CANCELLED
}

enum ScientificReviewConflictStatus {
  PENDING
  CLEAR
  CONFLICT
}

enum ScientificReviewRecommendation {
  ACCEPT
  REJECT
  CHANGES
}

model User {
  id                          String                       @id @default(cuid())
  name                        String
  email                       String                       @unique
  emailVerifiedAt             DateTime?
  credentialVersion           Int                          @default(0)
  passwordHash                String
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  ownedEvents                 Event[]                      @relation("EventOwner")
  createdEvents               Event[]                      @relation("EventCreatedBy")
  organizationsCreated        Organization[]               @relation("OrganizationCreatedBy")
  memberships                 OrganizationMembership[]     @relation("MembershipUser")
  membershipsInvited          OrganizationMembership[]     @relation("MembershipInvitedBy")
  auditLogs                   AuditLog[]                   @relation("AuditActor")
  passwordResetTokens         PasswordResetToken[]
  emailVerificationTokens     EmailVerificationToken[]
  passwordRecoveryAuditEvents PasswordRecoveryAuditEvent[]
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model PasswordRecoveryRateLimitBucket {
  id              String   @id @default(cuid())
  dimension       String   @db.VarChar(16)
  keyHash         String   @db.Char(64)
  windowStartedAt DateTime
  requestCount    Int      @default(1)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([dimension, keyHash, windowStartedAt])
  @@index([expiresAt])
}

model PasswordRecoveryAuditEvent {
  id            String                       @id @default(cuid())
  action        String                       @default("password_recovery.request") @db.VarChar(64)
  outcome       PasswordRecoveryAuditOutcome
  subjectUserId String?
  subjectUser   User?                        @relation(fields: [subjectUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime                     @default(now())

  @@index([outcome, createdAt])
  @@index([subjectUserId, createdAt])
}

model Organization {
  id          String                   @id @default(cuid())
  name        String
  slug        String                   @unique
  status      OrganizationStatus       @default(ACTIVE)
  createdById String
  createdBy   User                     @relation("OrganizationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  memberships OrganizationMembership[]
  events      Event[]
  auditLogs   AuditLog[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([createdById])
  @@index([status])
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  invitedById    String?
  invitedBy      User?            @relation("MembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  joinedAt       DateTime?        @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role, status])
}

model Event {
  id                             String                         @id @default(cuid())
  ownerId                        String
  owner                          User                           @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  organizationId                 String?
  organization                   Organization?                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdById                    String?
  createdBy                      User?                          @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  name                           String
  slug                           String                         @unique
  eventType                      String
  profileCode                    EventProfileCode?
  format                         EventFormat
  startDate                      DateTime?
  endDate                        DateTime?
  timeZone                       String?
  venue                          String?
  estimatedAudience              Int?
  registrationMode               RegistrationMode
  status                         EventStatus                    @default(DRAFT)
  capabilities                   EventCapability[]
  wizardSessions                 EventWizardSession[]
  eventPublication               EventPublication?
  eventPublicationSections       EventPublicationSection[]
  mediaAssets                    EventMediaAsset[]
  auditLogs                      AuditLog[]
  scientificPeople               ScientificPerson[]
  scientificRoles                ScientificRole[]
  scientificCommittees           ScientificCommittee[]
  scientificTaxonomyNodes        ScientificTaxonomyNode[]
  scientificGuests               ScientificGuestProfile[]
  scientificProgramSpaces        ScientificProgramSpace[]
  scientificProgramActivities    ScientificProgramActivity[]
  scientificProgramParticipants  ScientificProgramParticipant[]
  scientificSubmissionConfig     ScientificSubmissionConfig?
  scientificSubmissionModalities ScientificSubmissionModality[]
  scientificSubmissions          ScientificSubmission[]
  scientificReviewCriteria       ScientificReviewCriterion[]
  scientificReviewAssignments    ScientificReviewAssignment[]
  scientificReviews              ScientificReview[]
  scientificReviewScores         ScientificReviewScore[]
  registrationForm               EventRegistrationForm?
  registrationCatalog            EventRegistrationCatalog?
  registrationBenefitCatalog     EventRegistrationBenefitCatalog?
  registrationReservations       EventRegistrationReservation[]
  registrationCheckouts          EventRegistrationCheckout[]
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime                       @updatedAt

  @@unique([id, organizationId])
  @@index([ownerId])
  @@index([organizationId, createdAt])
  @@index([profileCode, status])
  @@index([createdById])
}

model EventCapability {
  id            String           @id @default(cuid())
  eventId       String
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code          String
  status        CapabilityStatus @default(ACTIVE)
  config        Json?
  schemaVersion Int              @default(1)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([eventId, code])
  @@index([code, status])
}

model EventRegistrationForm {
  id               String                         @id @default(cuid())
  organizationId   String
  eventId          String
  event            Event                          @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  revision         Int                            @default(1)
  fields           Json
  publishedVersion Int                            @default(0)
  versions         EventRegistrationFormVersion[]
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  @@unique([eventId, organizationId])
  @@unique([id, eventId, organizationId])
  @@index([organizationId, eventId])
}

model EventRegistrationFormVersion {
  id             String                @id @default(cuid())
  organizationId String
  eventId        String
  formId         String
  form           EventRegistrationForm @relation(fields: [formId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  version        Int
  schema         Json
  createdById    String
  createdAt      DateTime              @default(now())

  @@unique([formId, version])
  @@index([organizationId, eventId, version])
}


model EventRegistrationCatalog {
  id             String                      @id @default(cuid())
  organizationId String
  eventId        String
  event          Event                       @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  revision       Int                         @default(1)
  categories     EventRegistrationCategory[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([eventId, organizationId])
  @@unique([id, eventId, organizationId])
  @@index([organizationId, eventId])
}

model EventRegistrationCategory {
  id               String                       @id @default(cuid())
  organizationId   String
  eventId          String
  catalogId        String
  catalog          EventRegistrationCatalog     @relation(fields: [catalogId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade)
  code             String
  name             String
  description      String?
  capacity         Int?
  proofRequirement RegistrationProofRequirement @default(NONE)
  active           Boolean                      @default(true)
  sortOrder        Int                          @default(0)
  lots             EventRegistrationLot[]
  reservations     EventRegistrationReservation[]
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([eventId, code])
  @@index([organizationId, eventId, active])
  @@index([catalogId, sortOrder])
}

model EventRegistrationLot {
  id             String                    @id @default(cuid())
  organizationId String
  eventId        String
  categoryId     String
  category       EventRegistrationCategory @relation(fields: [categoryId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade)
  code           String
  name           String
  startsAt       DateTime
  endsAt         DateTime
  quantity       Int?
  priceCents     Int
  active         Boolean                   @default(true)
  sortOrder      Int                       @default(0)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  reservations   EventRegistrationReservation[]

  @@unique([id, eventId, organizationId])
  @@unique([categoryId, code])
  @@index([organizationId, eventId, active])
  @@index([categoryId, sortOrder])
  @@index([categoryId, startsAt, endsAt])
}

model EventRegistrationBenefitCatalog {
  id             String                     @id @default(cuid())
  organizationId String
  eventId        String
  event          Event                      @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  revision       Int                        @default(1)
  benefits       EventRegistrationBenefit[]
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([eventId, organizationId])
  @@unique([id, eventId, organizationId])
  @@index([organizationId, eventId])
}

model EventRegistrationBenefit {
  id              String                           @id @default(cuid())
  organizationId  String
  eventId         String
  catalogId       String
  catalog         EventRegistrationBenefitCatalog @relation(fields: [catalogId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade)
  code            String
  name            String
  kind            RegistrationBenefitKind
  discountPercent Int
  maxUses         Int
  usedCount       Int                              @default(0)
  validFrom       DateTime
  validUntil      DateTime
  active          Boolean                          @default(true)
  sortOrder       Int                              @default(0)
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt
  reservations    EventRegistrationReservation[]

  @@unique([id, eventId, organizationId])
  @@unique([eventId, code])
  @@index([organizationId, eventId, kind, active])
  @@index([catalogId, sortOrder])
}

model EventRegistrationReservation {
  id                 String                        @id @default(cuid())
  organizationId     String
  eventId            String
  event              Event                         @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  categoryId         String
  category           EventRegistrationCategory     @relation(fields: [categoryId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  lotId              String
  lot                 EventRegistrationLot          @relation(fields: [lotId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  benefitId          String?
  benefit            EventRegistrationBenefit?     @relation(fields: [benefitId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  protocol           String                        @unique @db.VarChar(32)
  idempotencyKeyHash String                        @db.Char(64)
  payloadHash        String                        @db.Char(64)
  identityHash       String                        @db.Char(64)
  emailHash          String                        @db.Char(64)
  registrationData   Json
  basePriceCents     Int
  discountPercent    Int                           @default(0)
  finalPriceCents    Int
  status             RegistrationReservationStatus
  expiresAt          DateTime?
  confirmedAt        DateTime?
  checkout           EventRegistrationCheckout?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  @@unique([eventId, idempotencyKeyHash])
  @@unique([eventId, identityHash])
  @@unique([id, eventId, organizationId])
  @@index([organizationId, eventId, status, expiresAt])
  @@index([eventId, lotId, status])
  @@index([eventId, benefitId, status])
}

model EventRegistrationCheckout {
  id                     String                       @id @default(cuid())
  organizationId         String
  eventId                String
  event                  Event                        @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reservationId          String                       @unique
  reservation            EventRegistrationReservation @relation(fields: [reservationId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  provider               String                       @default("ASAAS") @db.VarChar(20)
  providerCheckoutId     String?                      @db.VarChar(200)
  idempotencyKeyHash     String                       @db.Char(64)
  requestHash            String                       @db.Char(64)
  status                 RegistrationCheckoutStatus   @default(CREATING)
  checkoutUrl            String?                      @db.VarChar(512)
  amountCents            Int
  expiresAt              DateTime
  paidAt                 DateTime?
  failureCode            String?                      @db.VarChar(64)
  webhookEvents          AsaasCheckoutWebhookEvent[]
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  @@unique([provider, providerCheckoutId])
  @@unique([eventId, idempotencyKeyHash])
  @@unique([reservationId, eventId, organizationId])
  @@unique([id, eventId, organizationId])
  @@index([organizationId, eventId, status, expiresAt])
}

model AsaasCheckoutWebhookEvent {
  id                 String                     @id @default(cuid())
  organizationId     String?
  eventId            String?
  checkoutId         String?
  checkout           EventRegistrationCheckout? @relation(fields: [checkoutId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  providerEventId    String                     @unique @db.VarChar(200)
  externalCheckoutId String                     @db.VarChar(200)
  eventType          String                     @db.VarChar(64)
  checkoutStatus     String?                    @db.VarChar(32)
  amountCents        Int?
  payloadHash        String                     @db.Char(64)
  processedAt        DateTime?
  createdAt          DateTime                   @default(now())

  @@index([externalCheckoutId, processedAt])
  @@index([organizationId, eventId, createdAt])
}

model EventWizardSession {
  id                String              @id @default(cuid())
  eventId           String
  event             Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  flowVersion       String              @default("v2")
  currentStep       String              @default("profile")
  answers           Json                @default("{}")
  completionPercent Int                 @default(0)
  revision          Int                 @default(1)
  status            WizardSessionStatus @default(ACTIVE)
  lastSavedAt       DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([eventId, flowVersion])
  @@index([status, lastSavedAt])
}

model ScientificPerson {
  id                    String                          @id @default(cuid())
  organizationId        String
  eventId               String
  event                 Event                           @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  name                  String
  email                 String?
  institution           String?
  orcid                 String?
  notes                 String?
  status                ScientificPersonStatus          @default(ACTIVE)
  roleAssignments       ScientificPersonRole[]
  committeeMemberships  ScientificCommitteeMembership[]
  guestProfile          ScientificGuestProfile?
  programParticipations ScientificProgramParticipant[]
  submissionAuthors     ScientificSubmissionAuthor[]
  reviewAssignments     ScientificReviewAssignment[]
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([eventId, email])
  @@index([organizationId, eventId, status])
  @@index([eventId, name])
}

model ScientificRole {
  id                   String                          @id @default(cuid())
  organizationId       String
  eventId              String
  event                Event                           @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  code                 String
  label                String
  description          String?
  roleAssignments      ScientificPersonRole[]
  committeeMemberships ScientificCommitteeMembership[]
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([eventId, code])
  @@index([organizationId, eventId, label])
}

model ScientificPersonRole {
  id             String           @id @default(cuid())
  organizationId String
  eventId        String
  personId       String
  roleId         String
  person         ScientificPerson @relation(fields: [personId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade)
  role           ScientificRole   @relation(fields: [roleId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@unique([eventId, personId, roleId])
  @@index([organizationId, eventId])
}

model ScientificCommittee {
  id             String                          @id @default(cuid())
  organizationId String
  eventId        String
  event          Event                           @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  code           String
  name           String
  description    String?
  memberships    ScientificCommitteeMembership[]
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([eventId, code])
  @@index([organizationId, eventId, name])
}

model ScientificCommitteeMembership {
  id             String              @id @default(cuid())
  organizationId String
  eventId        String
  committeeId    String
  personId       String
  roleId         String?
  committee      ScientificCommittee @relation(fields: [committeeId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade)
  person         ScientificPerson    @relation(fields: [personId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade)
  role           ScientificRole?     @relation(fields: [roleId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  isChair        Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([eventId, committeeId, personId])
  @@index([organizationId, eventId, roleId])
}

model ScientificTaxonomyNode {
  id                         String                      @id @default(cuid())
  organizationId             String
  eventId                    String
  event                      Event                       @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  parentId                   String?
  parent                     ScientificTaxonomyNode?     @relation("ScientificTaxonomyTree", fields: [parentId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  children                   ScientificTaxonomyNode[]    @relation("ScientificTaxonomyTree")
  level                      ScientificTaxonomyLevel
  code                       String
  name                       String
  description                String?
  sortOrder                  Int                         @default(0)
  active                     Boolean                     @default(true)
  programActivitiesAsArea    ScientificProgramActivity[] @relation("ProgramActivityArea")
  programActivitiesAsSubarea ScientificProgramActivity[] @relation("ProgramActivitySubarea")
  programActivitiesAsTopic   ScientificProgramActivity[] @relation("ProgramActivityTopic")
  submissionsAsArea          ScientificSubmission[]      @relation("SubmissionArea")
  submissionsAsSubarea       ScientificSubmission[]      @relation("SubmissionSubarea")
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([eventId, code])
  @@index([organizationId, eventId, level, sortOrder])
  @@index([eventId, parentId])
}

model ScientificGuestProfile {
  id                    String                      @id @default(cuid())
  organizationId        String
  eventId               String
  personId              String
  event                 Event                       @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  person                ScientificPerson            @relation(fields: [personId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade)
  participationType     ScientificParticipationType
  customRoleLabel       String?
  displayName           String?
  professionalTitle     String?
  miniBio               String?
  websiteUrl            String?
  linkedinUrl           String?
  internalNotes         String?
  accessibilityNotes    String?
  technicalSupportNotes String?
  invitationStatus      ScientificInvitationStatus  @default(DRAFT)
  invitationTokenHash   String?                     @unique
  invitationExpiresAt   DateTime?
  preparedAt            DateTime?
  sentAt                DateTime?
  viewedAt              DateTime?
  respondedAt           DateTime?
  confirmedAt           DateTime?
  declinedAt            DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([personId, eventId, organizationId])
  @@index([organizationId, eventId, invitationStatus])
  @@index([eventId, participationType])
}

model ScientificProgramSpace {
  id             String                      @id @default(cuid())
  organizationId String
  eventId        String
  event          Event                       @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  name           String
  description    String?
  location       String?
  capacity       Int?
  kind           ScientificProgramSpaceKind
  active         Boolean                     @default(true)
  activities     ScientificProgramActivity[]
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([eventId, name])
  @@index([organizationId, eventId, active])
}

model ScientificProgramActivity {
  id                String                          @id @default(cuid())
  organizationId    String
  eventId           String
  event             Event                           @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  title             String
  activityType      String
  description       String?
  spaceId           String?
  space             ScientificProgramSpace?         @relation(fields: [spaceId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  startAt           DateTime
  endAt             DateTime
  status            ScientificProgramActivityStatus @default(DRAFT)
  taxonomyAreaId    String?
  taxonomyArea      ScientificTaxonomyNode?         @relation("ProgramActivityArea", fields: [taxonomyAreaId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  taxonomySubareaId String?
  taxonomySubarea   ScientificTaxonomyNode?         @relation("ProgramActivitySubarea", fields: [taxonomySubareaId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  taxonomyTopicId   String?
  taxonomyTopic     ScientificTaxonomyNode?         @relation("ProgramActivityTopic", fields: [taxonomyTopicId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  operationalNotes  String?
  participants      ScientificProgramParticipant[]
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt

  @@unique([id, eventId, organizationId])
  @@index([organizationId, eventId, startAt])
  @@index([eventId, spaceId, startAt])
  @@index([eventId, status])
}

model ScientificProgramParticipant {
  id                String                      @id @default(cuid())
  organizationId    String
  eventId           String
  event             Event                       @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  activityId        String
  activity          ScientificProgramActivity   @relation(fields: [activityId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade)
  personId          String
  person            ScientificPerson            @relation(fields: [personId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  participationType ScientificParticipationType
  customRoleLabel   String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([eventId, activityId, personId, participationType])
  @@unique([id, eventId, organizationId])
  @@index([organizationId, eventId, personId])
  @@index([eventId, activityId])
}

model ScientificSubmissionConfig {
  id               String               @id @default(cuid())
  organizationId   String
  eventId          String
  event            Event                @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  requireArea      Boolean              @default(false)
  requireSubarea   Boolean              @default(false)
  requireFile      Boolean              @default(false)
  maxSubmissionsPerAuthor Int            @default(1)
  minAuthors       Int                  @default(1)
  maxAuthors       Int?
  requirePresenter Boolean               @default(true)
  requireCorrespondingAuthor Boolean     @default(true)
  requireAuthorInstitution Boolean       @default(true)
  titleMaxLength   Int                   @default(250)
  minKeywords      Int                   @default(3)
  maxKeywords      Int                   @default(5)
  presentationFormats Json?
  reviewMode       ScientificReviewMode @default(SINGLE_BLIND)
  allowCorrections Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([eventId, organizationId])
}

model ScientificSubmissionModality {
  id             String                 @id @default(cuid())
  organizationId String
  eventId        String
  event          Event                  @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  code           String
  name           String
  description    String?
  active         Boolean                @default(true)
  rules          Json?
  submissions    ScientificSubmission[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([eventId, code])
  @@index([organizationId, eventId, active])
}

model ScientificSubmission {
  id                String                        @id @default(cuid())
  organizationId    String
  eventId           String
  event             Event                         @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  modalityId        String
  modality          ScientificSubmissionModality  @relation(fields: [modalityId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  title             String
  abstractText      String?
  keywords          Json?
  taxonomyAreaId    String?
  taxonomyArea      ScientificTaxonomyNode?       @relation("SubmissionArea", fields: [taxonomyAreaId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  taxonomySubareaId String?
  taxonomySubarea   ScientificTaxonomyNode?       @relation("SubmissionSubarea", fields: [taxonomySubareaId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  status            ScientificSubmissionStatus    @default(DRAFT)
  currentVersion    Int                           @default(0)
  submittedAt       DateTime?
  authors           ScientificSubmissionAuthor[]
  versions          ScientificSubmissionVersion[]
  reviewAssignments ScientificReviewAssignment[]
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@unique([id, eventId, organizationId])
  @@index([organizationId, eventId, status])
  @@index([eventId, modalityId, status])
  @@index([eventId, taxonomyAreaId, taxonomySubareaId])
}

model ScientificSubmissionAuthor {
  id              String               @id @default(cuid())
  organizationId  String
  eventId         String
  submissionId    String
  submission      ScientificSubmission @relation(fields: [submissionId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade)
  personId        String
  person          ScientificPerson     @relation(fields: [personId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  sortOrder       Int
  isPresenter     Boolean              @default(false)
  isCorresponding Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([eventId, submissionId, personId])
  @@unique([eventId, submissionId, sortOrder])
  @@index([organizationId, eventId, personId])
}

model ScientificSubmissionVersion {
  id                String                       @id @default(cuid())
  organizationId    String
  eventId           String
  submissionId      String
  submission        ScientificSubmission         @relation(fields: [submissionId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade)
  versionNumber     Int
  title             String
  abstractText      String?
  keywords          Json?
  fileKey           String?
  contentHash       String?
  submittedAt       DateTime
  reviewAssignments ScientificReviewAssignment[]
  createdAt         DateTime                     @default(now())

  @@unique([id, eventId, organizationId])
  @@unique([eventId, submissionId, versionNumber])
  @@index([organizationId, eventId, submissionId])
}

model ScientificReviewCriterion {
  id             String                  @id @default(cuid())
  organizationId String
  eventId        String
  event          Event                   @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  code           String
  label          String
  description    String?
  sortOrder      Int                     @default(0)
  active         Boolean                 @default(true)
  required       Boolean                 @default(true)
  minScore       Float
  maxScore       Float
  weight         Float                   @default(1)
  scores         ScientificReviewScore[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([eventId, code])
  @@index([organizationId, eventId, active, sortOrder])
}

model ScientificReviewAssignment {
  id               String                           @id @default(cuid())
  organizationId   String
  eventId          String
  event            Event                            @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  submissionId     String
  submission       ScientificSubmission             @relation(fields: [submissionId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  versionId        String
  version          ScientificSubmissionVersion      @relation(fields: [versionId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  reviewerPersonId String
  reviewer         ScientificPerson                 @relation(fields: [reviewerPersonId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  assignmentRound  Int                              @default(1)
  status           ScientificReviewAssignmentStatus @default(ASSIGNED)
  conflictStatus   ScientificReviewConflictStatus   @default(PENDING)
  conflictReason   String?
  dueAt            DateTime?
  startedAt        DateTime?
  submittedAt      DateTime?
  cancelledAt      DateTime?
  review           ScientificReview?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([eventId, submissionId, versionId, reviewerPersonId, assignmentRound])
  @@index([organizationId, eventId, reviewerPersonId, status])
  @@index([eventId, submissionId, versionId, status])
}

model ScientificReview {
  id                  String                          @id @default(cuid())
  organizationId      String
  eventId             String
  event               Event                           @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assignmentId        String
  assignment          ScientificReviewAssignment      @relation(fields: [assignmentId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  recommendation      ScientificReviewRecommendation?
  authorComment       String?
  confidentialComment String?
  submittedAt         DateTime?
  scores              ScientificReviewScore[]
  createdAt           DateTime                        @default(now())
  updatedAt           DateTime                        @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([assignmentId, eventId, organizationId])
  @@index([organizationId, eventId, submittedAt])
}

model ScientificReviewScore {
  id             String                    @id @default(cuid())
  organizationId String
  eventId        String
  event          Event                     @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  reviewId       String
  review         ScientificReview          @relation(fields: [reviewId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade)
  criterionId    String
  criterion      ScientificReviewCriterion @relation(fields: [criterionId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  value          Float
  comment        String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([eventId, reviewId, criterionId])
  @@index([organizationId, eventId, criterionId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUserId    String?
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  eventId        String?
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventId, createdAt])
}

model EventPublication {
  id                   String                    @id @default(cuid())
  organizationId       String
  eventId              String
  event                Event                     @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  shortDescription     String?
  fullDescription      String?
  publicContactEmail   String?
  publicContactPhone   String?
  logoAssetId          String?
  logoAsset            EventMediaAsset?          @relation("EventPublicationLogo", fields: [logoAssetId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  coverAssetId         String?
  coverAsset           EventMediaAsset?          @relation("EventPublicationCover", fields: [coverAssetId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  seoTitle             String?
  seoDescription       String?
  socialImageAssetId   String?
  socialImageAsset     EventMediaAsset?          @relation("EventPublicationSocialImage", fields: [socialImageAssetId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Restrict)
  accessibilitySummary String?
  themeConfig          Json?
  revision             Int                       @default(1)
  sections             EventPublicationSection[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([eventId, organizationId])
  @@unique([id, eventId, organizationId])
  @@index([organizationId, eventId, updatedAt])
}

model EventMediaAsset {
  id                    String               @id @default(cuid())
  organizationId        String
  eventId               String
  event                 Event                @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  usage                 EventMediaUsage
  storageKey            String               @unique
  mimeType              String
  byteSize              Int
  width                 Int
  height                Int
  checksumSha256        String
  altText               String?
  decorative            Boolean              @default(false)
  state                 EventMediaAssetState @default(ACTIVE)
  createdByUserId       String
  logoForPublications   EventPublication[]   @relation("EventPublicationLogo")
  coverForPublications  EventPublication[]   @relation("EventPublicationCover")
  socialForPublications EventPublication[]   @relation("EventPublicationSocialImage")
  replacedAt            DateTime?
  removedAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([id, eventId, organizationId])
  @@index([organizationId, eventId, usage, state])
  @@index([createdAt])
}

model EventPublicationSection {
  id                  String           @id @default(cuid())
  organizationId      String
  eventId             String
  event               Event            @relation(fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  publicationId       String
  publication         EventPublication @relation(fields: [publicationId, eventId, organizationId], references: [id, eventId, organizationId], onDelete: Cascade)
  kind                String
  title               String?
  enabled             Boolean          @default(true)
  sortOrder           Int              @default(0)
  content             Json             @default("{}")
  canonicalSourceType String?
  canonicalSourceId   String?
  revision            Int              @default(1)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([id, eventId, organizationId])
  @@unique([publicationId, sortOrder])
  @@index([organizationId, eventId, enabled, sortOrder])
  @@index([eventId, kind])
}

+  assert.equal((await fetch(url + '/adapters/unknown', { headers })).status, 404);
+  await db.eventRegistrationCheckout.update({ where: { id: checkout.id }, data: { status: 'CANCELED' } });
+  assert.equal((await send(token)).status, 404);

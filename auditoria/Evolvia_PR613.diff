@@ -0,0 +1,17 @@
+import { NotFoundException } from '@nestjs/common';
+import type { FiscalInvoiceDraft } from './nfse-draft-policy';
+
+/** Versioned internal input for a fiscal connector. Provider wire formats require separate homologation. */
+export function prepareFiscalAdapterPreview(provider: string, draft: FiscalInvoiceDraft) {
+  if (provider !== 'enotas' && provider !== 'notazz') {
+    throw new NotFoundException('Conector fiscal indisponível.');
+  }
+  return {
+    version: 1, provider, operation: 'PREVIEW', issueAuthorized: false,
+    idempotencyKey: draft.idempotencyKey,
+    source: { organizationId: draft.organizationId, eventId: draft.eventId, receiptId: draft.receiptId },
+    service: { municipalityIbgeCode: draft.municipalityIbgeCode, code: draft.serviceCode,
+      amountCents: draft.amountCents, currency: draft.currency },
+    parties: { issuerId: draft.issuerId, recipientId: draft.recipientId },
+  } as const;
+}
diff --git a/apps/api/src/nfse-draft-policy.ts b/apps/api/src/nfse-draft-policy.ts
new file mode 100644
index 00000000..aacdb5b4
--- /dev/null
+++ b/apps/api/src/nfse-draft-policy.ts
@@ -0,0 +1,144 @@
+import { createHash } from 'node:crypto';
+
+/**
+ * Gate G2.14 - deterministic fiscal request contract.
+ *
+ * This module does NOT issue invoices or talk to fiscal providers. Municipal
+ * adapters, issuer authorization, taxpayer verification and legal validation
+ * must exist before enabling emission in any environment.
+ */
+export class FiscalInvoicePolicyError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'FiscalInvoicePolicyError';
+  }
+}
+
+export type FiscalInvoiceSource = {
+  organizationId: string;
+  eventId: string;
+  reservationId: string;
+  receiptId: string;
+  paymentStatus: 'CONFIRMED' | 'PENDING' | 'REFUNDED' | 'CANCELLED';
+  amountCents: number;
+  currency: 'BRL';
+  municipalityIbgeCode: string;
+  issuerId: string;
+  recipientId: string;
+  serviceCode: string;
+};
+
+export type FiscalInvoiceDraft = {
+  idempotencyKey: string;
+  organizationId: string;
+  eventId: string;
+  reservationId: string;
+  receiptId: string;
+  amountCents: number;
+  currency: 'BRL';
+  municipalityIbgeCode: string;
+  issuerId: string;
+  recipientId: string;
+  serviceCode: string;
+  status: 'AWAITING_MUNICIPAL_ADAPTER';
+  issueAuthorized: false;
+};
+
+const ID = /^[A-Za-z0-9_-]{1,128}$/u;
+const IBGE = /^\d{7}$/u;
+// IBGE municipality codes begin with a valid Brazilian state code. This is
+// structural validation only; municipal adapter must validate the full code.
+const IBGE_UF = new Set(['11','12','13','14','15','16','17','21','22','23','24','25','26','27','28','29','31','32','33','35','41','42','43','50','51','52','53']);
+const SERVICE = /^[A-Za-z0-9.\-]{1,20}$/u;
+const MAX_CENTS = 999_999_999_999;
+
+export type FiscalSetup = Pick<FiscalInvoiceSource, 'issuerId' | 'recipientId' | 'serviceCode' | 'municipalityIbgeCode'>;
+
+export function validateFiscalSetup(input: FiscalSetup): void {
+  if (!input || typeof input !== 'object' || Array.isArray(input) ||
+      [input.issuerId, input.recipientId].some(id => typeof id !== 'string' || !ID.test(id))) {
+    throw new FiscalInvoicePolicyError('Referências fiscais inválidas.');
+  }
+  if (typeof input.municipalityIbgeCode !== 'string'
+    || !IBGE.test(input.municipalityIbgeCode)
+    || !IBGE_UF.has(input.municipalityIbgeCode.slice(0, 2))
+    || input.municipalityIbgeCode.slice(2) === '00000'
+    || typeof input.serviceCode !== 'string'
+    || !SERVICE.test(input.serviceCode)) {
+    throw new FiscalInvoicePolicyError('Município ou código de serviço inválido.');
+  }
+}
+
+export function prepareFiscalInvoiceDraft(input: FiscalInvoiceSource): FiscalInvoiceDraft {
+  if (!input || typeof input !== 'object' || Array.isArray(input)) {
+    throw new FiscalInvoicePolicyError('Referências fiscais inválidas.');
+  }
+  const ids = [input.organizationId, input.eventId, input.reservationId,
+    input.receiptId];
+  if (ids.some((id) => typeof id !== 'string' || !ID.test(id))) {
+    throw new FiscalInvoicePolicyError('Referências fiscais inválidas.');
+  }
+  if (input.paymentStatus !== 'CONFIRMED') {
+    throw new FiscalInvoicePolicyError('A nota exige pagamento confirmado e não estornado.');
+  }
+  if (input.currency !== 'BRL' || !Number.isSafeInteger(input.amountCents)
+    || input.amountCents <= 0 || input.amountCents > MAX_CENTS) {
+    throw new FiscalInvoicePolicyError('Valor fiscal inválido.');
+  }
+  validateFiscalSetup(input);
+  const keySource = [
+    'nfse-draft-v1', input.organizationId, input.eventId, input.reservationId,
+    input.receiptId, input.issuerId, input.recipientId, input.municipalityIbgeCode,
+    input.serviceCode, String(input.amountCents),
+  ].join(':');
+  return {
+    idempotencyKey: createHash('sha256').update(keySource).digest('hex'),
+    organizationId: input.organizationId,
+    eventId: input.eventId,
+    reservationId: input.reservationId,
+    receiptId: input.receiptId,
+    amountCents: input.amountCents,
+    currency: input.currency,
+    municipalityIbgeCode: input.municipalityIbgeCode,
+    issuerId: input.issuerId,
+    recipientId: input.recipientId,
+    serviceCode: input.serviceCode,
+    status: 'AWAITING_MUNICIPAL_ADAPTER',
+    issueAuthorized: false,
+  };
+}
+
+export function requireMunicipalFiscalAuthorization(
+  draft: FiscalInvoiceDraft,
+): never {
+  // Fail closed: no adapter / municipal homologation / explicit opt-in exists yet.
+  // This prevents a payment receipt being mislabeled an issued tax document.
+  void draft;
+  throw new FiscalInvoicePolicyError(
+    'NFS-e não emitida: adaptador municipal e homologação fiscal ainda indisponíveis.',
+  );
+}
+
+/**
+ * Reconcile repeated paid receipts in a fiscal draft batch. A retry of an
+ * identical receipt is safe, but changed fiscal details require investigation.
+ * This function never sends an invoice to a municipal provider.
+ */
+export function prepareFiscalInvoiceDraftBatch(
+  sources: readonly FiscalInvoiceSource[],
+): FiscalInvoiceDraft[] {
+  if (!Array.isArray(sources) || sources.length === 0 || sources.length > 100) {
+    throw new FiscalInvoicePolicyError('Lote de rascunhos fiscais inválido.');
+  }
+  const byReceipt = new Map<string, FiscalInvoiceDraft>();
+  for (const source of sources) {
+    const draft = prepareFiscalInvoiceDraft(source);
+    const scope = [draft.organizationId, draft.receiptId].join(':');
+    const existing = byReceipt.get(scope);
+    if (existing && existing.idempotencyKey !== draft.idempotencyKey) {
+      throw new FiscalInvoicePolicyError('Recibo com dados fiscais conflitantes.');
+    }
+    if (!existing) byReceipt.set(scope, draft);
+  }
+  return [...byReceipt.values()];
+}
diff --git a/apps/api/src/nfse-draft-store.ts b/apps/api/src/nfse-draft-store.ts
new file mode 100644
index 00000000..a167cde8
--- /dev/null
+++ b/apps/api/src/nfse-draft-store.ts
@@ -0,0 +1,73 @@
+import { setTimeout as delay } from 'node:timers/promises';
+import { BadRequestException, ConflictException, NotFoundException } from '@nestjs/common';
+import { Prisma, type PrismaClient } from '@prisma/client';
+import { FiscalInvoicePolicyError, validateFiscalSetup, type FiscalSetup } from './nfse-draft-policy';
+import { previewFiscalReceipt } from './nfse-receipt-draft';
+
+export async function readOrPrepareFiscalDraft(
+  db: Pick<PrismaClient, '$transaction'>, userId: string, eventId: string, receiptId: string,
+  command?: { setup: FiscalSetup },
+) {
+  for (let attempt = 1; ; attempt++) {
+    try {
+      return await db.$transaction(async tx => {
+        const event = await tx.event.findFirst({
+          where: { id: eventId, organization: { memberships: { some: { userId, status: 'ACTIVE', role: 'OWNER' } } } },
+          select: { organizationId: true },
+        });
+        if (!event?.organizationId) throw new NotFoundException('Recibo indisponível.');
+        const organizationId = event.organizationId;
+        const stored = await tx.fiscalReceiptDraft.findFirst({
+          where: { receiptId, receipt: { eventId, organizationId } },
+        });
+        if (!command && !stored) throw new NotFoundException('Prévia fiscal indisponível.');
+        const setup = command ? command.setup : stored!;
+        try {
+          validateFiscalSetup(setup);
+        } catch (error) {
+          if (error instanceof FiscalInvoicePolicyError) throw new BadRequestException(error.message);
+          throw error;
+        }
+        if (setup.issuerId !== organizationId) {
+          throw new BadRequestException('O emissor precisa corresponder à organização do recibo.');
+        }
+        const draft = await previewFiscalReceipt(tx, { userId, organizationId, eventId, receiptId }, setup);
+        if (stored && stored.idempotencyKey !== draft.idempotencyKey) {
+          throw new ConflictException('Os dados fiscais divergem da prévia registrada.');
+        }
+        if (!stored) {
+          // Hold the eligibility rows through commit. Concurrent changes invalidate
+          // this serializable snapshot and must pass the checks on a fresh read.
+          const authorized = await tx.$queryRaw<Array<{ id: string }>>`
+            SELECT m.id FROM "EventRegistrationPaymentReceipt" r
+            JOIN "OrganizationMembership" m ON m."organizationId" = r."organizationId"
+            JOIN "EventRegistrationCheckout" c ON c.id = r."checkoutId"
+            JOIN "EventRegistrationReservation" s ON s.id = r."reservationId"
+            WHERE r.id = ${receiptId} AND r."eventId" = ${eventId} AND r."organizationId" = ${organizationId}
+              AND m."userId" = ${userId} AND m.status = 'ACTIVE' AND m.role = 'OWNER'
+              AND c.status = 'PAID' AND c."paidAt" IS NOT NULL AND s.status = 'CONFIRMED'
+            FOR SHARE OF r, m, c, s
+          `;
+          if (!authorized.length) throw new NotFoundException('Recibo indisponível.');
+          await tx.fiscalReceiptDraft.create({ data: {
+            receiptId, idempotencyKey: draft.idempotencyKey, issuerId: draft.issuerId,
+            recipientId: draft.recipientId, municipalityIbgeCode: draft.municipalityIbgeCode, serviceCode: draft.serviceCode,
+          } });
+          await tx.auditLog.create({ data: {
+            organizationId, eventId, actorUserId: userId, action: 'nfse.draft_prepared',
+            entityType: 'FiscalReceiptDraft', entityId: receiptId,
+          } });
+        }
+        return draft;
+      }, { isolationLevel: Prisma.TransactionIsolationLevel.Serializable });
+    } catch (error) {
+      if (error instanceof FiscalInvoicePolicyError) throw new NotFoundException('Recibo indisponível.');
+      if (!(error instanceof Prisma.PrismaClientKnownRequestError)) throw error;
+      const serializationFailure = error.code === 'P2010' && error.meta?.code === '40001';
+      if (!serializationFailure && !['P2034','P2002'].includes(error.code)) throw error;
+      if (attempt >= 4) throw new ConflictException('Prévia em atualização. Repita a consulta.');
+      const windowMs = 10 * 2 ** (attempt - 1);
+      await delay(windowMs + Math.floor(Math.random() * windowMs));
+    }
+  }
+}
diff --git a/apps/api/src/nfse-receipt-draft.ts b/apps/api/src/nfse-receipt-draft.ts

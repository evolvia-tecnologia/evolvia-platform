+async function fiscalFixture(t) {
+  const db = new PrismaClient();
+  t.after(() => db.$disconnect());
+  class FiscalTestModule {}
+  Module({
+    imports: [JwtModule.register({ secret: randomUUID() })],
+    controllers: [EventFinancialResponsibilityController],
